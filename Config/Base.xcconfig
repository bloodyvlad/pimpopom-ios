// Owner-selected PimPoPom app identifier. Keep OAuth, signing, and release records aligned.
PRODUCT_BUNDLE_IDENTIFIER = com.otcsoftware.pimpopom

IPHONEOS_DEPLOYMENT_TARGET = 17.0
MARKETING_VERSION = 1.01
CURRENT_PROJECT_VERSION = 5
SWIFT_VERSION = 6.0
SWIFT_STRICT_CONCURRENCY = complete
TARGETED_DEVICE_FAMILY = 1
CODE_SIGN_STYLE = Automatic

// Public OAuth identifiers. The iOS client is intentionally a disabled placeholder
// until an iOS OAuth client is created for the final development bundle identifier.
PIMPOPOM_GOOGLE_IOS_CLIENT_ID = placeholder.apps.googleusercontent.com
PIMPOPOM_GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.placeholder
PIMPOPOM_GOOGLE_SERVER_CLIENT_ID = 121091636571-4551g9k0uh39rqit36kkli74u0rnuens.apps.googleusercontent.com

// The public AdMob App ID is present in every build so UMP resolves the
// PimPoPom privacy message. Ad units stay disabled unless a named
// configuration below deliberately enables them.
PIMPOPOM_ADMOB_APP_ID = ca-app-pub-6428992187280935~3622035442
PIMPOPOM_ADS_MODE = disabled
PIMPOPOM_ADMOB_BANNER_UNIT_ID =
PIMPOPOM_ADMOB_INTERSTITIAL_UNIT_ID =
PIMPOPOM_ADMOB_TEST_DEVICE_IDS =
PIMPOPOM_ADMOB_OWNER_BANNER_UNIT_ID =
PIMPOPOM_ADMOB_OWNER_INTERSTITIAL_UNIT_ID =
PIMPOPOM_OWNER_DEVICE_IDFV_SHA256 =
